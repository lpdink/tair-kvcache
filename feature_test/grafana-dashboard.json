{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "title": "Block Hit Rate (1m window)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(kvcm_manager_get_cache_location_hit_block_counter[1m])) / sum(rate(kvcm_manager_get_cache_location_query_block_counter[1m]))",
          "legendFormat": "Hit Rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Query & Hit Blocks (per 30s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kvcm_manager_get_cache_location_query_block_counter[30s]))",
          "legendFormat": "Query",
          "refId": "A"
        },
        {
          "expr": "sum(rate(kvcm_manager_get_cache_location_hit_block_counter[30s]))",
          "legendFormat": "Hit",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Cumulative Block Counters",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(kvcm_manager_get_cache_location_query_block_counter)",
          "legendFormat": "Total Queried",
          "refId": "A"
        },
        {
          "expr": "sum(kvcm_manager_get_cache_location_hit_block_counter)",
          "legendFormat": "Total Hit",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Hit Rate Over Time",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(kvcm_manager_get_cache_location_hit_block_counter[1m])) / sum(rate(kvcm_manager_get_cache_location_query_block_counter[1m]))",
          "legendFormat": "Hit Rate (1m)",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 41,
  "tags": ["kvcm", "hit-rate"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "KVCacheManager - Block Hit Rate",
  "uid": "kvcm-hit-rate",
  "version": 3
}
